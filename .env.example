# Copy to .env.local

# Redis-backed content store
REDIS_URL=redis://default:your-password@your-host:6379

# Admin login for the dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# GitHub streak stats
GITHUB_USERNAME=NandaKumar876
GITHUB_TOKEN=github_pat_replace_with_your_token

# Optional — Email notifications for contact form
# Option A: Nodemailer SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_SECURE=false

# Option B: Resend API
# RESEND_API_KEY=re_123456789

# Admin email recipient (checked: ADMIN_EMAIL -> EMAIL_TO -> NOTIFY_EMAIL)
ADMIN_EMAIL=admin@yourdomain.com

# Sender address (checked: EMAIL_FROM -> FROM_EMAIL -> SMTP_USER)
EMAIL_FROM=you@gmail.com
